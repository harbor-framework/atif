---
import { getCanonicalMdUrl, getSpecVersion } from '../lib/spec-loader';

interface Props {
  pathname?: string;
  specVersionDir?: string;
}

const pathname = Astro.props.pathname ?? Astro.url.pathname;
const mdHref = getCanonicalMdUrl(pathname);

const versionMatch = pathname.match(/^\/spec\/(v\d+\.\d+)(?:\/|$)/);
const versionDir = Astro.props.specVersionDir ?? versionMatch?.[1];
const versionInfo = versionDir ? getSpecVersion(versionDir) : undefined;

const SCHEMA_LABELS: Record<string, string> = {
  'atif-record.schema.json': 'JSON Schema',
  'atif.proto': 'Protobuf',
  'warehouse.sql': 'Warehouse DDL',
};

const schemaLinks = (versionInfo?.schemas ?? [])
  .filter((s) => s.fileName in SCHEMA_LABELS)
  .map((s) => ({ label: SCHEMA_LABELS[s.fileName], hint: s.fileName, href: s.href }));

// The single-fetch Markdown bundle only exists for v2.0.
if (schemaLinks.length > 0 && versionDir === 'v2.0') {
  schemaLinks.push({ label: 'Full spec, one file', hint: 'full.md', href: '/spec/v2.0/full.md' });
}

const menuId = 'atif-page-actions-menu';
---

<div class="atif-pa" data-page-actions data-pagefind-ignore>
  <div class="atif-pa__split">
    <button
      type="button"
      class="atif-pa__main"
      data-copy-md-url={mdHref}
      aria-label="Copy page as Markdown"
    >
      <svg class="atif-pa__icon atif-pa__icon--copy" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="5.5" y="2.5" width="8" height="9.5" rx="1.5" stroke="currentColor" stroke-width="1.35" />
        <path d="M3.5 5.5H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      </svg>
      <svg class="atif-pa__icon atif-pa__icon--done" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="atif-pa__label" data-copy-label aria-live="polite">Copy page</span>
    </button>
    <button
      type="button"
      class="atif-pa__toggle"
      data-pa-toggle
      aria-haspopup="menu"
      aria-expanded="false"
      aria-controls={menuId}
      aria-label="More page actions"
    >
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <div class="atif-pa__menu" id={menuId} role="menu" aria-label="Page actions" data-pa-menu hidden>
    <button type="button" class="atif-pa__item" role="menuitem" tabindex="-1" data-copy-md-url={mdHref}>
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="5.5" y="2.5" width="8" height="9.5" rx="1.5" stroke="currentColor" stroke-width="1.35" />
        <path d="M3.5 5.5H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      </svg>
      <span class="atif-pa__item-label">Copy page as Markdown</span>
      <span class="atif-pa__item-hint">for LLMs</span>
    </button>
    <a class="atif-pa__item" role="menuitem" tabindex="-1" href={mdHref}>
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 1.75h5.25L12.5 5v8.25a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2.75a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
        <path d="M9 1.75V5.25h3.5" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round" />
        <path d="M5.5 8.5h4.5M5.5 11h3" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" />
      </svg>
      <span class="atif-pa__item-label">View as Markdown</span>
      <span class="atif-pa__item-hint">.md</span>
    </a>

    {schemaLinks.length > 0 && (
      <div class="atif-pa__group" role="group" aria-label={`${versionDir} machine-readable sources`}>
        <div class="atif-pa__group-label" aria-hidden="true">{versionDir} sources</div>
        {schemaLinks.map((link) => (
          <a class="atif-pa__item" role="menuitem" tabindex="-1" href={link.href}>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M6 2.5c-1.4 0-2 .6-2 1.8v1.9c0 .9-.5 1.5-1.4 1.8.9.3 1.4.9 1.4 1.8v1.9c0 1.2.6 1.8 2 1.8M10 2.5c1.4 0 2 .6 2 1.8v1.9c0 .9.5 1.5 1.4 1.8-.9.3-1.4.9-1.4 1.8v1.9c0 1.2-.6 1.8-2 1.8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="atif-pa__item-label">{link.label}</span>
            <span class="atif-pa__item-hint">{link.hint}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<script is:inline>
  (() => {
    if (window.__atifPageActionsBound) return;
    window.__atifPageActionsBound = true;

    const menuFor = (toggle) => document.getElementById(toggle.getAttribute('aria-controls'));
    const itemsOf = (menu) => Array.from(menu.querySelectorAll('[role="menuitem"]'));
    const openToggle = () => document.querySelector('[data-pa-toggle][aria-expanded="true"]');

    function setOpen(toggle, open, focus) {
      const menu = menuFor(toggle);
      if (!menu) return;
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      if (open && focus) {
        const items = itemsOf(menu);
        (focus === 'last' ? items[items.length - 1] : items[0])?.focus();
      }
    }

    function closeMenu(returnFocus) {
      const toggle = openToggle();
      if (!toggle) return;
      setOpen(toggle, false);
      if (returnFocus) toggle.focus();
    }

    async function copyMarkdown(trigger) {
      const url = trigger.getAttribute('data-copy-md-url');
      const root = trigger.closest('[data-page-actions]');
      const label = root?.querySelector('[data-copy-label]');
      if (!url) return;
      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        await navigator.clipboard.writeText(await res.text());
        if (root && label) {
          const original = label.dataset.original || label.textContent || 'Copy page';
          label.dataset.original = original;
          label.textContent = 'Copied';
          root.setAttribute('data-copied', '');
          clearTimeout(root.__atifCopyTimer);
          root.__atifCopyTimer = setTimeout(() => {
            label.textContent = original;
            root.removeAttribute('data-copied');
          }, 1800);
        }
      } catch {
        window.open(url, '_blank', 'noopener');
      }
    }

    document.addEventListener('click', (event) => {
      const el = event.target instanceof Element ? event.target : null;
      if (!el) return;

      const toggle = el.closest('[data-pa-toggle]');
      if (toggle) {
        const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
        // Keyboard activation (detail === 0) moves focus into the menu.
        setOpen(toggle, willOpen, willOpen && event.detail === 0 ? 'first' : undefined);
        return;
      }

      const copy = el.closest('[data-copy-md-url]');
      if (copy) {
        const fromMenu = Boolean(copy.closest('[data-pa-menu]'));
        copyMarkdown(copy);
        closeMenu(fromMenu);
        return;
      }

      // Following a menu link, or clicking anywhere outside, dismisses the menu.
      if (el.closest('[data-pa-menu] [role="menuitem"]') || !el.closest('[data-pa-menu]')) {
        closeMenu(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      const el = event.target instanceof Element ? event.target : null;
      if (!el) return;

      if (event.key === 'Escape') {
        if (openToggle()) {
          event.preventDefault();
          closeMenu(true);
        }
        return;
      }

      const toggle = el.closest('[data-pa-toggle]');
      if (toggle && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        event.preventDefault();
        setOpen(toggle, true, event.key === 'ArrowUp' ? 'last' : 'first');
        return;
      }

      const menu = el.closest('[data-pa-menu]');
      if (!menu) return;
      const items = itemsOf(menu);
      const index = items.indexOf(document.activeElement);
      let next = -1;
      if (event.key === 'ArrowDown') next = (index + 1) % items.length;
      else if (event.key === 'ArrowUp') next = (index - 1 + items.length) % items.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = items.length - 1;
      else if (event.key === 'Tab') closeMenu(false);
      if (next >= 0) {
        event.preventDefault();
        items[next].focus();
      }
    });

    document.addEventListener('focusin', (event) => {
      const el = event.target instanceof Element ? event.target : null;
      if (el && openToggle() && !el.closest('[data-page-actions]')) closeMenu(false);
    });
  })();
</script>

<style>
  .atif-pa {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    font-size: 0.8125rem;
  }

  /* One split control: copy on the left, everything else behind the chevron */
  .atif-pa__split {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--atif-border);
    border-radius: 0.45rem;
    background: var(--atif-surface);
    transition: border-color 140ms ease;
  }

  .atif-pa__split:hover,
  .atif-pa__split:focus-within {
    border-color: var(--atif-border-strong);
  }

  .atif-pa__main,
  .atif-pa__toggle {
    display: inline-flex;
    align-items: center;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
    transition: color 120ms ease, background-color 120ms ease;
  }

  .atif-pa__main {
    gap: 0.4rem;
    padding: 0.28rem 0.6rem 0.28rem 0.55rem;
    border-radius: 0.4rem 0 0 0.4rem;
  }

  .atif-pa__toggle {
    padding: 0 0.4rem;
    border-inline-start: 1px solid var(--atif-border);
    border-radius: 0 0.4rem 0.4rem 0;
    color: var(--atif-text-muted);
  }

  .atif-pa__main:hover,
  .atif-pa__toggle:hover,
  .atif-pa__toggle[aria-expanded='true'] {
    background: color-mix(in oklch, var(--atif-ink) 5%, transparent);
    color: var(--sl-color-white);
  }

  .atif-pa__icon {
    flex-shrink: 0;
    color: var(--atif-text-muted);
  }

  .atif-pa__icon--done {
    display: none;
    color: var(--atif-emerald);
  }

  .atif-pa[data-copied] .atif-pa__icon--copy {
    display: none;
  }

  .atif-pa[data-copied] .atif-pa__icon--done {
    display: block;
  }

  .atif-pa__menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 30;
    width: max-content;
    min-width: 17rem;
    max-width: min(21rem, calc(100vw - 2rem));
    padding: 0.3rem;
    border: 1px solid var(--atif-border);
    border-radius: 0.65rem;
    background: var(--atif-surface);
    box-shadow: var(--atif-shadow-pop);
    animation: atif-pa-in 140ms cubic-bezier(0.2, 0.7, 0.2, 1);
    transform-origin: top right;
  }

  .atif-pa__menu[hidden] {
    display: none;
  }

  @keyframes atif-pa-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.985);
    }
  }

  .atif-pa__item {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    margin: 0;
    padding: 0.45rem 0.55rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    color: var(--sl-color-white);
    font-family: var(--sl-font);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.35;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .atif-pa__item svg {
    color: var(--atif-text-muted);
  }

  .atif-pa__item:hover,
  .atif-pa__item:focus-visible {
    outline: none;
    background: color-mix(in oklch, var(--atif-ink) 6%, transparent);
  }

  .atif-pa__item:focus-visible {
    box-shadow: inset 0 0 0 2px var(--atif-emerald);
  }

  .atif-pa__item:hover svg,
  .atif-pa__item:focus-visible svg {
    color: var(--atif-emerald);
  }

  .atif-pa__item-hint {
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--atif-text-muted);
    white-space: nowrap;
  }

  .atif-pa__group {
    margin-top: 0.3rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--atif-border);
  }

  .atif-pa__group-label {
    padding: 0.35rem 0.55rem 0.25rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--atif-text-muted);
  }

  @media (max-width: 30rem) {
    .atif-pa__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .atif-pa__main {
      padding-inline: 0.5rem;
    }
  }
</style>

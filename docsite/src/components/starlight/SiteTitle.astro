---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="ATIF — Agent Trajectory Interchange Format">
  <img
    src="/logo-light.svg"
    alt="ATIF"
    class="atif-logo atif-logo--light"
    width="89"
    height="28"
  />
  <img
    src="/logo-dark.svg"
    alt="ATIF"
    class="atif-logo atif-logo--dark"
    width="89"
    height="28"
  />
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .atif-logo {
    height: 28px;
    width: auto;
    display: block;
  }

  :global([data-theme='dark']) .atif-logo--light,
  :global(:root:not([data-theme='light'])) .atif-logo--light {
    display: none;
  }

  :global([data-theme='light']) .atif-logo--dark {
    display: none;
  }
</style>

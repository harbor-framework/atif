---
import PageAgentActions from '../PageAgentActions.astro';
import VersionSwitcher from '../VersionSwitcher.astro';
import { discoverSpecVersions, getSpecVersion } from '../../lib/spec-loader';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const pathname = Astro.url.pathname;

const versionMatch = pathname.match(/^\/spec\/(v\d+\.\d+)(\/changelog)?(?:\/|$)/);
const currentVersion = versionMatch ? getSpecVersion(versionMatch[1]) : undefined;
const allVersions = currentVersion ? discoverSpecVersions() : [];
const isVersionChangelog = Boolean(versionMatch?.[2]);
---

<div class="atif-page-header">
  <h1 id="_top">{entry.data.title}</h1>
  {!isSplash && (
    <div class="atif-utility-bar" data-pagefind-ignore>
      {currentVersion && (
        <VersionSwitcher
          versions={allVersions}
          currentVersion={currentVersion}
          subPath={isVersionChangelog ? 'changelog' : 'spec'}
        />
      )}
      <PageAgentActions pathname={pathname} specVersionDir={currentVersion?.dirName} />
    </div>
  )}
</div>

<style>
  @layer starlight.core {
    .atif-page-header {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    h1 {
      margin-top: 0.35rem;
      margin-bottom: 0;
      font-size: clamp(1.85rem, 3vw, 2.35rem);
      line-height: 1.18;
      font-weight: 650;
      letter-spacing: -0.025em;
      color: var(--sl-color-white);
      text-wrap: balance;
    }

    .atif-utility-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem 1.25rem;
      padding-top: 0.2rem;
    }
  }
</style>

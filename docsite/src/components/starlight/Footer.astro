---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<div class="atif-site-footer" data-pagefind-ignore>
  <p class="atif-site-footer__copy">
    <svg class="atif-site-footer__mark" width="30" height="10" viewBox="0 0 40 12" fill="none" aria-hidden="true">
      <circle cx="6" cy="6" r="4.25" stroke="currentColor" stroke-width="3" />
      <path d="M17 3H40L37 9H14L17 3Z" fill="currentColor" />
    </svg>
    <span>Agent Trajectory Interchange Format · Apache-2.0 open standard · Originated in Harbor</span>
  </p>
  <nav class="atif-site-footer__links" aria-label="Machine-readable endpoints">
    <a href="/.well-known/skills/atif/SKILL.md">Agent Skill</a>
    <a href="/llms.txt">llms.txt</a>
    <a href="/spec/v2.0/full.md">Full Spec (.md)</a>
    <a href="/spec/changelog/">Changelog</a>
    <a href="https://github.com/harbor-framework/atif">GitHub</a>
  </nav>
</div>

<style>
  .atif-site-footer {
    margin-top: 3rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--atif-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--atif-text-muted);
  }

  .atif-site-footer__copy {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
  }

  .atif-site-footer__mark {
    flex-shrink: 0;
    color: var(--atif-emerald);
  }

  .atif-site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
  }

  .atif-site-footer__links a {
    color: var(--atif-text-muted);
    text-decoration: none;
    transition: color 140ms ease;
  }

  .atif-site-footer__links a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-decoration-color: var(--atif-emerald);
    text-underline-offset: 0.25em;
  }
</style>

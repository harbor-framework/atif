---
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { getLatestSpecVersion } from '../../lib/spec-loader';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
const latest = getLatestSpecVersion();
const specHref = latest ? latest.href : '/spec/v2.0/';
const pathname = Astro.url.pathname;

const navLinks = [
  {
    label: 'Spec',
    href: specHref,
    active: pathname.startsWith('/spec/') && !pathname.startsWith('/spec/changelog'),
  },
  {
    label: 'Guides',
    href: '/guides/quickstart/',
    active: pathname.startsWith('/guides/'),
  },
  {
    label: 'Validator',
    href: '/validator/',
    active: pathname.startsWith('/validator'),
  },
  {
    label: 'Changelog',
    href: '/spec/changelog/',
    active: pathname.startsWith('/spec/changelog'),
  },
];
---

<div class="header">
  <div class="left-group sl-flex">
    <div class="title-wrapper sl-flex"><SiteTitle /></div>
    <nav class="top-nav sl-hidden md:sl-flex" aria-label="Primary">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class:list={['top-nav__link', { 'top-nav__link--active': item.active }]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="sl-flex print:hidden search-slot">{shouldRenderSearch && <Search />}</div>

  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <ThemeSelect />
    <div class="sl-flex social-icons"><SocialIcons /></div>
  </div>

  {!hasSidebar && (
    <details class="atif-mobile-nav md:sl-hidden print:hidden">
      <summary class="atif-mobile-nav__toggle" aria-label="Open navigation menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="atif-mobile-nav__panel">
        <nav class="atif-mobile-nav__links" aria-label="Mobile primary navigation">
          {navLinks.map((item) => (
            <a
              href={item.href}
              class:list={['atif-mobile-nav__link', { 'atif-mobile-nav__link--active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="atif-mobile-nav__utils">
          <ThemeSelect />
          <SocialIcons />
        </div>
      </div>
    </details>
  )}
</div>

<style>
  @layer starlight.core {
    .header {
      display: flex;
      gap: var(--sl-nav-gap);
      justify-content: space-between;
      align-items: center;
      height: 100%;
      position: relative;
    }

    .left-group {
      align-self: stretch;
      align-items: center;
      gap: 1.75rem;
      min-width: 0;
    }

    .title-wrapper {
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
      min-width: 0;
      flex-shrink: 0;
    }

    .top-nav {
      align-self: stretch;
      align-items: stretch;
      gap: 0.35rem;
    }

    .top-nav__link {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 0 0.6rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--atif-text-muted);
      text-decoration: none;
      transition: color 140ms ease;
      white-space: nowrap;
    }

    .top-nav__link:hover {
      color: var(--sl-color-white);
    }

    /* Current section: a chamfered emerald rail segment seated on the header's hairline */
    .top-nav__link::after {
      content: '';
      position: absolute;
      left: 0.6rem;
      right: 0.6rem;
      bottom: calc(-1 * var(--sl-nav-pad-y) - 1px);
      height: 3px;
      background: var(--atif-emerald);
      transform: skewX(var(--atif-chamfer)) scaleX(0);
      transform-origin: left center;
      transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .top-nav__link--active {
      color: var(--sl-color-white);
      font-weight: 600;
    }

    .top-nav__link--active::after {
      transform: skewX(var(--atif-chamfer)) scaleX(1);
    }

    .search-slot {
      justify-content: flex-end;
      flex: 1;
      max-width: 19rem;
    }

    .right-group,
    .social-icons {
      gap: 0.85rem;
      align-items: center;
    }

    .social-icons {
      padding-inline-start: 0.85rem;
      border-inline-start: 1px solid var(--atif-border);
    }

    /* Mobile navigation menu for splash pages without Starlight sidebar (/ and /validator/) */
    .atif-mobile-nav {
      position: relative;
      flex-shrink: 0;
    }

    .atif-mobile-nav__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 0.375rem;
      border: 1px solid var(--atif-border-strong);
      background: var(--atif-surface);
      color: var(--sl-color-white);
      cursor: pointer;
      list-style: none;
    }

    .atif-mobile-nav__toggle::-webkit-details-marker {
      display: none;
    }

    .atif-mobile-nav__panel {
      position: fixed;
      top: var(--sl-nav-height);
      inset-inline: 0;
      z-index: var(--sl-z-index-navbar);
      background: var(--sl-color-bg-nav);
      border-bottom: 1px solid var(--atif-border);
      padding: 0.85rem 1.15rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      box-shadow: var(--sl-shadow-md);
    }

    .atif-mobile-nav__links {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .atif-mobile-nav__link {
      display: block;
      padding: 0.55rem 0.7rem;
      border-radius: 0.35rem;
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--sl-color-white);
      text-decoration: none;
    }

    .atif-mobile-nav__link--active {
      background: var(--atif-accent-tint);
      color: var(--atif-accent-tint-ink);
      font-weight: 600;
    }

    .atif-mobile-nav__utils {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 0.75rem;
      border-top: 1px solid var(--atif-border);
    }
  }
</style>

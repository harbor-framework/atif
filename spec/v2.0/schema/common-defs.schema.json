{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atif.dev/schema/v2.0/common-defs.schema.json",
  "title": "ATIF v2.0 Common Schema Definitions",
  "description": "Shared JSON Schema 2020-12 definitions for Agent Trajectory Interchange Format (ATIF) v2.0.",
  "$comment": "Canonical ATIF JSON emitters serialize integer fields as JSON integers. Standard Proto3 protojson encoders quote int64 fields as decimal strings; ATIF JSON parsers SHOULD leniently accept decimal strings for int64 fields before strict schema validation.",
  "$defs": {
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC timestamp string (e.g. '2026-10-30T18:00:00Z')."
    },
    "Sha256Urn": {
      "type": "string",
      "pattern": "^urn:sha256:[0-9a-f]{64}$",
      "description": "Content-addressed SHA-256 digest URN ('urn:sha256:<64-lowercase-hex>')."
    },
    "ArdUrn": {
      "type": "string",
      "minLength": 1,
      "description": "Recommended Agentic Resource Discovery (ARD) URN ('urn:air:<publisher>:<namespace>:<name>') or resource identifier string."
    },
    "Modality": {
      "type": "string",
      "minLength": 1,
      "examples": ["text", "image", "audio", "video", "document"],
      "description": "Content or token modality."
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": true
    },
    "Extensions": {
      "type": "object",
      "description": "Reverse-DNS domain or RFC 3986 URI-keyed map of extension object payloads.",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "DocumentType": {
      "type": "string",
      "enum": ["events", "trajectories"],
      "description": "ATIF v2.0 NDJSON document mode."
    },
    "AtifRecordType": {
      "type": "string",
      "enum": ["meta", "event", "session", "trajectory", "step", "extension"],
      "description": "Universal AtifRecord line discriminator."
    },
    "TrajectoryLineageReason": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "subagent",
        "fork",
        "rewind",
        "retry",
        "candidate",
        "compaction",
        "continuation",
        "other"
      ]
    },
    "TrajectoryStatus": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "running",
        "completed",
        "failed",
        "cancelled",
        "max_steps",
        "context_limit"
      ]
    },
    "StepSource": {
      "type": "string",
      "enum": ["system", "user", "agent"]
    },
    "StopReason": {
      "type": "string",
      "minLength": 1,
      "examples": [
        "completed",
        "tools",
        "cancelled",
        "max_tokens",
        "timed_out",
        "errored",
        "refused"
      ]
    },
    "ActionExecutor": {
      "type": "string",
      "enum": ["client", "environment", "provider", "external"],
      "description": "Closed 4-value execution plane distinguishing where tool execution occurred."
    },
    "ActionType": {
      "type": "string",
      "minLength": 1,
      "examples": ["tool", "system", "user_interaction", "policy", "internal"]
    },
    "CostSource": {
      "type": "string",
      "minLength": 1,
      "examples": ["reported", "estimated"]
    },
    "ContentPartType": {
      "type": "string",
      "enum": [
        "text",
        "reasoning",
        "data",
        "image",
        "audio",
        "video",
        "document",
        "action"
      ]
    },
    "TruncationStrategy": {
      "type": "string",
      "enum": ["head", "tail", "head_tail"]
    },
    "FileScope": {
      "type": "string",
      "enum": [
        "workspace",
        "computer",
        "memory",
        "session",
        "scratch",
        "artifact"
      ]
    },
    "BlobReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type"],
      "properties": {
        "digest": { "$ref": "#/$defs/Sha256Urn" },
        "uri": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "filename": { "type": "string" }
      }
    },
    "TruncationInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "original_bytes": { "type": "integer", "minimum": 0 },
        "strategy": { "$ref": "#/$defs/TruncationStrategy" },
        "blob": { "$ref": "#/$defs/BlobReference" }
      }
    },
    "TruncatedFieldsMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/TruncationInfo" }
    },
    "MediaSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type"],
      "properties": {
        "digest": { "$ref": "#/$defs/Sha256Urn" },
        "uri": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "filename": { "type": "string" },
        "duration_sec": { "type": "number", "minimum": 0 }
      }
    },
    "ReasoningContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "summarized": { "type": "boolean" },
        "signature": { "type": "string" }
      }
    },
    "ContentPartBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/ContentPartType" },
        "text": { "type": "string" },
        "reasoning": { "$ref": "#/$defs/ReasoningContent" },
        "data": { "$ref": "#/$defs/JsonObject" },
        "source": { "$ref": "#/$defs/MediaSource" },
        "action_id": { "type": "string", "minLength": 1 },
        "truncated_fields": { "$ref": "#/$defs/TruncatedFieldsMap" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "oneOf": [
        {
          "required": ["text"],
          "properties": { "type": { "const": "text" } }
        },
        {
          "required": ["reasoning"],
          "properties": { "type": { "const": "reasoning" } }
        },
        {
          "required": ["data"],
          "properties": { "type": { "const": "data" } }
        },
        {
          "required": ["source"],
          "properties": {
            "type": { "enum": ["image", "audio", "video", "document"] }
          }
        },
        {
          "required": ["action_id"],
          "properties": { "type": { "const": "action" } }
        }
      ]
    },
    "ContentPart": {
      "description": "Consolidated ContentPart (type discriminator required in trajectories documents).",
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/ContentPartBase" },
        { "required": ["type"] }
      ]
    },
    "ContentPartEvent": {
      "description": "Streaming ContentPart in events documents (type discriminator optional; inferred during consolidation).",
      "$ref": "#/$defs/ContentPartBase"
    },
    "Citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": { "type": "string" },
        "title": { "type": "string" },
        "cited_text": { "type": "string" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "CompactionInfo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "limit",
            "manual",
            "agent",
            "subagent_handoff",
            "pruning",
            "injection"
          ]
        },
        "boundary": {
          "type": "string",
          "minLength": 1,
          "examples": ["replace", "truncate", "append"]
        },
        "event_id_start": { "type": "string" },
        "event_id_end": { "type": "string" },
        "step_id_start": { "type": "integer", "minimum": 1 },
        "step_id_end": { "type": "integer", "minimum": 1 },
        "summary": { "type": "string" },
        "tokens_before": { "type": "integer", "minimum": 0 },
        "tokens_after": { "type": "integer", "minimum": 0 },
        "compaction_trajectory_id": { "type": "string" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "GranularTokenUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_name": { "type": "string" },
        "modality": { "$ref": "#/$defs/Modality" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "StepMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_tokens": { "type": "integer", "minimum": 0 },
        "cache_write_tokens": { "type": "integer", "minimum": 0 },
        "reasoning_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "cost_source": { "$ref": "#/$defs/CostSource" },
        "retry_count": { "type": "integer", "minimum": 0 },
        "time_to_first_token_ms": { "type": "number", "minimum": 0 },
        "duration_ms": { "type": "number", "minimum": 0 },
        "response_id": { "type": "string" },
        "prompt_token_ids": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "completion_token_ids": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "logprobs": {
          "type": "array",
          "items": { "type": "number" }
        },
        "granular": {
          "type": "array",
          "items": { "$ref": "#/$defs/GranularTokenUsage" }
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "FinalMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_input_tokens": { "type": "integer", "minimum": 0 },
        "total_output_tokens": { "type": "integer", "minimum": 0 },
        "total_cache_read_tokens": { "type": "integer", "minimum": 0 },
        "total_cache_write_tokens": { "type": "integer", "minimum": 0 },
        "total_reasoning_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "cost_source": { "$ref": "#/$defs/CostSource" },
        "total_steps": { "type": "integer", "minimum": 0 },
        "total_llm_calls": { "type": "integer", "minimum": 0 },
        "total_duration_ms": { "type": "number", "minimum": 0 },
        "granular": {
          "type": "array",
          "items": { "$ref": "#/$defs/GranularTokenUsage" }
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "ModelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "provider": { "type": "string" },
        "version": { "type": "string" },
        "reasoning_effort": {
          "type": "string",
          "examples": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
        },
        "reasoning_budget": { "type": "number", "minimum": 0 },
        "context_window_tokens": { "type": "integer", "minimum": 0 },
        "supported_modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Modality" }
        },
        "parameters": { "$ref": "#/$defs/JsonObject" },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "SkillDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "uri": { "type": "string" },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "type": { "type": "string" },
        "source": { "$ref": "#/$defs/BlobReference" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "McpServerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "transport": {
          "type": "string",
          "examples": ["stdio", "sse", "streamable_http", "in_process"]
        },
        "uri": { "type": "string" },
        "command": { "type": "string" },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version": { "type": "string" },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "SubagentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "model_name": { "type": "string" },
        "system_instructions": { "type": "string" },
        "allowed_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "truncated_fields": { "$ref": "#/$defs/TruncatedFieldsMap" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "input_schema": { "$ref": "#/$defs/JsonObject" },
        "output_schema": { "$ref": "#/$defs/JsonObject" },
        "annotations": { "$ref": "#/$defs/JsonObject" },
        "executor": { "$ref": "#/$defs/ActionExecutor" },
        "mcp_server": { "type": "string" },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "AgentMetadataProperties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "role": { "type": "string" },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "model": { "$ref": "#/$defs/ModelMetadata" },
        "system_instructions": { "type": "string" },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/SkillDefinition" }
        },
        "mcp_servers": {
          "type": "array",
          "items": { "$ref": "#/$defs/McpServerDefinition" }
        },
        "subagents": {
          "type": "array",
          "items": { "$ref": "#/$defs/SubagentDefinition" }
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/ToolDefinition" }
        },
        "truncated_fields": { "$ref": "#/$defs/TruncatedFieldsMap" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "AgentMetadata": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/AgentMetadataProperties" },
        { "required": ["name"] }
      ]
    },
    "AgentMetadataPatch": {
      "$ref": "#/$defs/AgentMetadataProperties"
    },
    "SandboxMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "image": { "type": "string" },
        "network_restricted": { "type": "boolean" },
        "filesystem_restricted": { "type": "boolean" },
        "writable_roots": {
          "type": "array",
          "items": { "type": "string" }
        },
        "approval_mode": { "type": "string" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "VcsMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "type": "string",
          "examples": ["git", "jj", "hg", "perforce", "other"]
        },
        "repo_uri": { "type": "string" },
        "root_dir": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "dirty": { "type": "boolean" },
        "diff": { "$ref": "#/$defs/BlobReference" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "EnvironmentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "os": { "type": "string" },
        "os_version": { "type": "string" },
        "arch": { "type": "string" },
        "cwd": { "type": "string" },
        "shell": { "type": "string" },
        "identifier": { "$ref": "#/$defs/ArdUrn" },
        "sandbox": { "$ref": "#/$defs/SandboxMetadata" },
        "vcs": { "$ref": "#/$defs/VcsMetadata" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "ApprovalInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authority"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "timeout"]
        },
        "authority": {
          "type": "string",
          "enum": ["user", "agent", "policy"]
        },
        "reason": { "type": "string" },
        "reviewer": { "type": "string" },
        "decision_time": { "$ref": "#/$defs/Timestamp" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "EventBranch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after_event_id": { "type": "string", "minLength": 1 },
        "reason": {
          "type": "string",
          "minLength": 1,
          "examples": ["rewind", "retry"]
        }
      }
    },
    "ExtensionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "data"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "data": { "$ref": "#/$defs/JsonObject" }
      }
    }
  }
}

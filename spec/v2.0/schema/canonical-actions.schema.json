        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "glob_pattern": {
          "type": "string"
        },
        "recursive": {
          "type": "boolean"
        }
      }
    },
    "CanonicalFileList": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/CanonicalFileListProps"
        },
        {
          "required": [
            "directory"
          ]
        }

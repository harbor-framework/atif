        "task_id": {
          "type": "string"
        },
        "channel_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "CanonicalMessageRead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        },
        "message_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "senders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageParticipant"
          }

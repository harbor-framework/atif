{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atif.dev/schema/v2.0/canonical-actions.schema.json",
  "title": "ATIF v2.0 Canonical Actions Schema",
  "description": "JSON Schema 2020-12 for Action.canonical (CanonicalAction), covering all 28 canonical action types and orthogonal MCP provenance.",
  "$comment": "The root schema validates any CanonicalAction (strict variant required fields, optional type discriminator). Use #/$defs/CanonicalActionStrict for consolidated trajectories documents (requires type) and #/$defs/CanonicalActionPartial for streaming events output updates (allows partial member patches such as { shell_command: { exit_code: 0 } }).",
  "$ref": "#/$defs/CanonicalAction",
  "$defs": {
    "CanonicalActionType": {
      "type": "string",
      "enum": [
        "multi",
        "subagent",
        "message_send",
        "message_read",
        "elicitation",
        "timer",
        "synthetic_context",
        "task_status",
        "task_list",
        "task_stop",
        "shell_command",
        "shell_send_input",
        "script_exec",
        "file_read",
        "file_write",
        "file_search",
        "file_list",
        "file_move",
        "file_delete",
        "search",
        "web_fetch",
        "skill_activate",
        "skill_reference",
        "skill_script",
        "generate_media",
        "mcp_tool",
        "extension",
        "resource_discovery"
      ]
    },
    "CanonicalMcpProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_name",
        "tool_name"
      ],
      "properties": {
        "server_name": {
          "type": "string",
          "minLength": 1
        },
        "server_identifier": {
          "$ref": "common-defs.schema.json#/$defs/ArdUrn"
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MessageParticipant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "trajectory_id": {
          "type": "string"
        },
        "identifier": {
          "$ref": "common-defs.schema.json#/$defs/ArdUrn"
        }
      }
    },
    "CanonicalMultiAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalAction"
          }
        }
      }
    },
    "CanonicalMultiActionStrict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalActionStrict"
          }
        }
      }
    },
    "CanonicalMultiActionPartial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CanonicalActionPartial"
          }
        }
      }
    },
    "CanonicalSubagent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trajectory_id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "agent_name": {
          "type": "string"
        },
        "agent_identifier": {
          "$ref": "common-defs.schema.json#/$defs/ArdUrn"
        },
        "prompt": {
          "type": "string"
        },
        "usage": {
          "$ref": "common-defs.schema.json#/$defs/FinalMetrics"

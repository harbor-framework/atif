    "CanonicalSyntheticContext": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/CanonicalSyntheticContextProps"
        },
        {
          "required": [
            "source"
          ]
        }
      ]
    },
    "CanonicalTaskStatusProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "wait": {

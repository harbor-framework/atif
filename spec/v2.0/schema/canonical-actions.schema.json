          ]
        }
      ]
    },
    "CanonicalFileDeleteProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "common-defs.schema.json#/$defs/FileScope"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "recursive": {
          "type": "boolean"
        },
        "before_digest": {
          "$ref": "common-defs.schema.json#/$defs/Sha256Urn"

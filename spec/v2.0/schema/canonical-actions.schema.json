    "CanonicalTaskStop": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/CanonicalTaskStopProps"
        },
        {
          "required": [
            "task_id"
          ]
        }
      ]
    },
    "CanonicalShellCommandProps": {
      "type": "object",

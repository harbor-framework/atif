    "CanonicalFileMoveProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "common-defs.schema.json#/$defs/FileScope"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "destination": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CanonicalFileMove": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/CanonicalFileMoveProps"
        },
        {
          "required": [
            "source",

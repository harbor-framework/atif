      }
    },
    "CanonicalElicitation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/CanonicalElicitationProps"
        },
        {
          "required": [
            "question"
          ]
        }
      ]
    },
    "CanonicalTimer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_sec": {
          "type": "number",

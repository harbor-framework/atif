        }
      ]
    },
    "CanonicalScriptExec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pid": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "path": {
          "type": "string"
